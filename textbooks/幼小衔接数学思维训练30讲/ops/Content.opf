<package xmlns="http://www.idpf.org/2007/opf" unique-identifier="ISBN" version="2.0">
<metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:opf="http://www.idpf.org/2007/opf" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<dc:source>cnpiec V1.0</dc:source>
<dc:title>幼小衔接数学思维训练30讲</dc:title>
<dc:creator>全脑开发教研中心著</dc:creator>
<dc:language>ENG</dc:language>
<dc:identifier id="ISBN">978-7-115-53726-3</dc:identifier>
<dc:publisher>CNPeReading</dc:publisher>
<dc:date>2020-07-01</dc:date>
<meta content="CoverDesign" name="coverpage"/>
<description xmlns="http://purl.org/dc/elements/1.1/">&lt;p&gt;本书从感知集合、数量关系、空间方位、几何图形、基本运算、日期时间、钱币购物、简单推理等方面分30讲对学前儿童的数学思维能力进行了训练，对典型的思维训练题进行了解析，并给出了大量的思维训练题帮助孩子巩固练习。</description>
</metadata>
